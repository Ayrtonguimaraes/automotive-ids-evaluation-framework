{
    "feat_gen": {
        "feature_generator": "CNNIDSFeatureGenerator",
        "config": {
            "window_size": 44,
            "window_slide": 1,
            "number_of_bytes": 58,
            "multiclass": false,
            "labeling_schema": "AVTP_Intrusion_dataset",
            "dataset": "AVTP_Intrusion_dataset",
            "sum_x": true
        },
        "load_paths": {
            "X_path": "sample_inputs/sample_input_sum_aggregated.npz",
            "y_path": "sample_inputs/sample_label_one_class_avtp_rounded.npz"
        }
    },
    "model_specs": {
        "framework": "sklearn",
        "model": "SklearnClassifier",
        "model_name": "RandomForestClassifier",
        "model_params": {
            "n_estimators": 100,
            "max_depth": 4,
            "max_features": 3,
            "bootstrap": true,
            "random_state": 42
        },
        "presaved_paths": {
            "0": "retrained/aeid_rf/RandomForestClassifier_fold_0.pkl",
            "1": "retrained/aeid_rf/RandomForestClassifier_fold_1.pkl",
            "2": "retrained/aeid_rf/RandomForestClassifier_fold_2.pkl",
            "3": "retrained/aeid_rf/RandomForestClassifier_fold_3.pkl",
            "4": "retrained/aeid_rf/RandomForestClassifier_fold_4.pkl"
        }
    }
}
